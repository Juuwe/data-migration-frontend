@startuml
skinparam componentStyle rectangle
skinparam nodePadding 18

node "Телефон / планшет" as Phone {
  component "PWA\n(feed, grid, add, login)" as PWA
  component "Service Worker\n(кэш оболочки)" as SW
}

node "Ноутбук в локальной сети" as Laptop {
  node "Node.js reverse proxy\nhttps://<IP>:3443" as Proxy {
    artifact "Статика dist/\nSPA fallback" as Static
    component "Прокси /api" as ApiProxy
    component "Прокси /s3" as S3Proxy
  }

  node "Vite dev server\nhttp://localhost:3000" as Vite {
    component "React SPA\nHMR" as DevSpa
  }

  node "Go web service\nhttp://localhost:8081" as API {
    component "Домен методов\n/api/methods" as MethodsApi
    component "Домен пользователей\n/api/users" as UsersApi
  }

  database "PostgreSQL\n:5432" as DB
  database "Redis\n:6379" as Redis
  database "MinIO S3\n:9010" as MinIO
}

cloud "GitHub" {
  node "GitHub Actions" as CI
  node "GitHub Pages\nHTTPS, mock-режим" as Pages
}

PWA --> Proxy : HTTPS
PWA --> Pages : HTTPS
PWA ..> SW : офлайн-кэш
SW ..> Static : precache

Proxy --> Static : файлы
ApiProxy --> MethodsApi : HTTP /api/methods
ApiProxy --> UsersApi : HTTP /api/users
S3Proxy --> MinIO : S3 API /s3/*
MethodsApi --> DB : PostgreSQL TCP
UsersApi --> DB : PostgreSQL TCP
API --> Redis : RESP, JWT blacklist
MethodsApi --> MinIO : S3 API, медиа

DevSpa --> API : HTTP, Vite proxy
CI --> Pages : deploy dist

note right of Pages
  GitHub Pages работает только
  с mock-коллекцией (VITE_STATIC_MODE)
end note

@enduml
