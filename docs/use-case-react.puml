@startuml
left to right direction
skinparam packageStyle rectangle

actor "Гость" as Guest
actor "Авторизованный пользователь" as User

Guest <|-- User

rectangle "React SPA интерфейса миграции данных" {
  usecase "Просмотреть ленту" as UCFeed
  usecase "Перейти к следующей услуге" as UCNext
  usecase "Поставить или снять лайк" as UCLike
  usecase "Просмотреть плитку услуг" as UCGrid
  usecase "Отфильтровать услуги по времени" as UCFilter
  usecase "Открыть услугу из плитки" as UCOpen
  usecase "Войти" as UCLogin
  usecase "Зарегистрироваться" as UCRegister
  usecase "Выйти" as UCLogout
  usecase "Создать черновик услуги" as UCCreate
  usecase "Опубликовать услугу" as UCPublish
  usecase "Удалить свою услугу" as UCDelete
  usecase "Просмотреть медиа из MinIO" as UCMedia
  usecase "Получить mock-данные\nпри недоступном бэкенде" as UCMock
}

Guest --> UCFeed
Guest --> UCNext
Guest --> UCGrid
Guest --> UCFilter
Guest --> UCOpen
Guest --> UCLogin
Guest --> UCRegister
Guest --> UCMedia

User --> UCLike
User --> UCLogout
User --> UCCreate
User --> UCPublish
User --> UCDelete

UCOpen ..> UCFeed : <<include>>
UCNext ..> UCFeed : <<include>>
UCDelete ..> UCGrid : <<include>>
UCFeed ..> UCMedia : <<include>>
UCGrid ..> UCMedia : <<include>>
UCCreate ..> UCMedia : <<include>>
UCFeed <.. UCMock : <<extend>>
UCGrid <.. UCMock : <<extend>>

@enduml
